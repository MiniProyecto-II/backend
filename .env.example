# Copiar a .env y completar localmente. Nunca versionar .env ni credenciales Admin.
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://uv-stream.vercel.app
FIREBASE_PROJECT_ID=replace_with_project_id
FIREBASE_CLIENT_EMAIL=replace_with_service_account_email
FIREBASE_PRIVATE_KEY="replace_with_private_key_using_escaped_newlines"
BASE_COLLECTION=system
BASE_DOCUMENT=base

# Configuración WEB pública de Firebase para construir el frontend en Compose.
# Estos valores VITE_* nunca deben contener credenciales Admin.
VITE_FIREBASE_API_KEY=replace_with_public_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_auth_domain
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_APP_ID=replace_with_web_app_id
VITE_DOMINIO_CORREO=correounivalle.edu.co
