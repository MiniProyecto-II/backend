# Copia este archivo a .env y completa los valores. NUNCA subas el .env al repositorio.

PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS (separados por coma). En producción: el dominio de Vercel.
CORS_ORIGINS=http://localhost:5173

# Credenciales de Firebase Admin (Firebase Console > Configuración del proyecto > Cuentas de servicio)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave privada en UNA sola línea, con los saltos de línea como \n y entre comillas
FIREBASE_PRIVATE_KEY=

# Documento de Firestore que lee la base técnica (colección/documento)
BASE_COLLECTION=system
BASE_DOCUMENT=base
