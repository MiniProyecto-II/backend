{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "../src/config/env.ts"]
}
