# Copia este archivo a backend-realtime/.env y completa los valores. Nunca subas el .env al repositorio.
PORT=3001
NODE_ENV=
# Orígenes permitidos, exactos y separados por coma: el dominio de Vercel y/o http://localhost:5173
CORS_ORIGINS=

# Credenciales de Firebase Admin (las mismas que la API). Opción recomendada (Render y Docker):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clave privada en UNA sola línea, con los saltos de línea como \n y entre comillas
FIREBASE_PRIVATE_KEY=

# Alternativa: ruta absoluta a un serviceAccountKey.json montado fuera de Git (si no se usan las FIREBASE_*)
GOOGLE_APPLICATION_CREDENTIALS=
# Nunca exponer estas variables al navegador ni copiarlas al DUE.
